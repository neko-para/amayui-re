{
  // ★ 本工程 = `pnpm typecheck` 的**最后一档**（独立一条 `tsc -p …/examples/tsconfig.json`）。
  //   为什么单列而不并进 base 的 include：flags 比 base 更严（见下），且这一档是"只看 `plugin.d.ts`
  //   能不能写出插件"的**教学样本**（`quickts` 的 `ts-examples-compile` 要求 `import type` 整条擦掉、
  //   零 module request —— 与发行插件不同，后者有运行期 `./lib/*.ts` import）。
  //   ★ 2026-11-28（T1）起**发行插件本身就是 `.ts`**（`plugins/*.ts` + `lib/*.ts`，由
  //   `plugins/tsconfig.json` 那一条 tsc 覆盖）；本目录仍只放示例、不参与构建。
  //   漂移样例的口径：`script` 名必须是 marker 文件名（含 `.BIN`，精确相等）—— 本目录里的裸名
  //   `"TITLE"` / `"SBUNKI"` 是**占位**，⛔ 不要照抄（`plugin.d.ts` 的用法段已写成 `.BIN`）。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // ★ S1b 常设门禁：插件将来要**直接在宿主 QJS 里跑**（quickts E1 只做纯类型擦除）⇒
    //   enum / 构造参数属性 / 含值 namespace / `import =` 这类"要生成代码"的写法必须在
    //   类型检查期就红，而不是等到运行期。`erasableSyntaxOnly` 只查"可擦"，运行期覆盖见 CTest
    //   `plugin-runtime` 的 `plugin/ts-module` / `quickts`。
    "erasableSyntaxOnly": true
  },
  "include": ["./*.ts", "../plugin.d.ts"]
}
