click 690 323
await position SBUNKI 0x0F60 0x1040 timeout 8000
await script SC0000 timeout 120000
await position SC0000 0x194C0 0x19540 timeout 90000
wait 8000
click 500 500
await script SC4000 timeout 120000
await position SC4000 0x5800 0x5860 timeout 60000
wait 3000
click 500 500
await position SC4000 0x5920 0x5960 timeout 60000
wait 2000
click 500 500
await position BUNKI 0x0B00 0x0C00 timeout 120000
wait 2000
click 640 393
await position SC4000 0x6B00 0x6B80 timeout 120000
wait 3000
click 500 500
await position SC4000 0x6B80 0x6C00 timeout 60000
wait 1500
click 500 500
await position SC4000 0x6C00 0x6D00 timeout 60000
wait 1500
click 500 500
await position SC4000 0x10D00 0x10E00 timeout 60000
wait 1000
