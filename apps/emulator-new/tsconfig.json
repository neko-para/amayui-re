{
  // apps/emulator-new/tsconfig.json —— **只做类型检查，不产出**（`noEmit`）
  //
  // ★ 为什么 `types: ["node"]`（与 `apps/emulator` 核心相反）：本 app 是**工具侧**的参考实现 ——
  //   它要从命令行读脚本（`node:fs`）、用 `Buffer` 装 body。核心的分层守卫（`types: []`）属于
  //   `apps/emulator`；这里的目标是"实现与 `data/spec` 的类型自洽"。
  // ★ `erasableSyntaxOnly`：代码由 Node 原生剥壳直接跑，`enum` / `namespace` / 参数属性 / 装饰器会运行期炸。
  // ★ 仍然**没有构建步骤**：`tsc` 只把"类型写错"变成红灯。
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}
