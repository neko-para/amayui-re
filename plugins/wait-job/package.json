{
  "name": "@amayui/dsh-plugin-wait-job",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "事件驱动的 wait_job 工具：等一个后台任务，并在用户插话 / turn 取消时立刻返回（结算时把正文带回，不依赖完成通知）",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  }
}
