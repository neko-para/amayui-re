{
  "name": "amayui-re",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "packages/*",
    "tools",
    "apps/workbench",
    "plugins/*"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none \"{tools/test/**/*.test.mjs,packages/*/test/**/*.test.mjs,plugins/*/test/**/*.test.mjs}\"",
    "tools": "node tools/cli.mjs"
  },
  "pnpm": {
    "overrides": {
      "markdown-it>entities": "^7.0.1"
    }
  }
}
